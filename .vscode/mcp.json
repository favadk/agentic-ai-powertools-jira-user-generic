{
  "inputs": [],
  "servers": {
    "issue-tracker": {
      "type": "stdio",
      "command": "${workspaceFolder}/.tools/IssueTracker.Mcp.exe",
      "env": {
        "ISSUE_TRACKER_URL": "https://app.example.com",
        "ISSUE_TRACKER_TOKEN": "DUMMY_ISSUE_TRACKER_TOKEN_FOR_LOCAL_TESTING_ONLY",
        "ISSUE_TRACKER_SSL_VERIFY": "false"
      }
    },
    "source-control": {
      "type": "stdio",
      "command": "${workspaceFolder}/.tools/SourceControl.Mcp.exe",
      "env": {
        "SOURCE_CONTROL_URL": "https://app.example.com",
        "SOURCE_CONTROL_TOKEN": "DUMMY_SOURCE_CONTROL_TOKEN_FOR_LOCAL_TESTING_ONLY",
        "SOURCE_CONTROL_DEFAULT_PROJECT": "DEMO"
      }
    },
    "knowledge-base": {
      "type": "stdio",
      "command": "${workspaceFolder}/.tools/KnowledgeBase.Mcp.exe",
      "env": {
        "KNOWLEDGE_BASE_URL": "https://app.example.com",
        "KNOWLEDGE_BASE_TOKEN": "DUMMY_KNOWLEDGE_BASE_TOKEN_FOR_LOCAL_TESTING_ONLY",
        "KNOWLEDGE_BASE_SSL_VERIFY": "false"
      }
    },
    "assist-hub": {
      "type": "https",
      "url": "https://app.example.com",
      "comment": "Replace URL with your own environment endpoint"
    }
  }
}
